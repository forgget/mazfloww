{
  "name": "mazflow-server",
  "version": "1.0.0",
  "private": true,
  "description": "Servidor do MazFlow (Gráfica Mazart): login seguro, aprovação de cadastros e bloqueio de IP",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:migrar": "node scripts/migrar.js",
    "liberar-ip": "node scripts/liberar-ip.js",
    "test": "node --test --test-concurrency=1 test/",
    "db:juntar": "node scripts/juntar-sql.js"
  },
  "dependencies": {
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.6.0"
  }
}
