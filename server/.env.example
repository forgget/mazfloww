# Copie para .env e preencha. Nunca envie o .env para o GitHub.

NODE_ENV=development
PORT=3000
# Endereço público do sistema (em produção, com https://)
APP_URL=http://localhost:3000

# E-mail do dono: o primeiro cadastro com este e-mail vira administrador
DONO_EMAIL=dono@graficamazart.com.br

# Banco: use DATABASE_URL (hospedagem) OU as variáveis DB_*
# DATABASE_URL=mysql://usuario:senha@host:3306/mazflow
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=mazflow_app
DB_PASSWORD=
DB_NAME=mazflow

# E-mail (Brevo, Resend, Gmail...). Vazio = e-mails aparecem só no log
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=MazFlow <nao-responda@graficamazart.com.br>

# Quantos proxies ficam na frente do servidor (1 na maioria das hospedagens)
TRUST_PROXY=0
